# Cognito — server-only.
#
# These are identifiers, not secrets, but they are NOT prefixed NEXT_PUBLIC_:
# the entire OIDC exchange happens server-side, so nothing about auth needs to
# reach the browser, and nothing does.
#
# Local:  copy to .env.local (gitignored)
# Deploy: set under Amplify -> App settings -> Environment variables
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
